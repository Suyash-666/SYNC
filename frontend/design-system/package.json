    "axios": "^1.7.7",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.290.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.28.0",
